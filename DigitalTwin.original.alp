							<Id>1772354370922</Id>
							<OccurrenceAtTime>true</OccurrenceAtTime>
							<OccurrenceDate>1772438400000</OccurrenceDate>
							<OccurrenceTime Class="CodeUnitValue">
								<Code>5</Code>
								<Unit Class="TimeUnits">WEEK</Unit>
							</OccurrenceTime>
							<RecurrenceCode Class="CodeUnitValue">
